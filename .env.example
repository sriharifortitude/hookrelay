DATABASE_URL="postgresql://hookrelay:hookrelay_local_dev@127.0.0.1:5434/hookrelay?schema=public"
REDIS_URL="redis://127.0.0.1:6381"
# Bootstraps applications. 32+ random bytes, base64:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ADMIN_API_KEY=""
PORT=4000
# In production, endpoint URLs must be https and must not resolve to private
# address space. Set to "true" only for local testing against a loopback receiver.
ALLOW_INSECURE_ENDPOINTS=false
