{
  "openapi": "3.1.0",
  "info": {
    "title": "hookrelay",
    "version": "0.1.0",
    "description": "Outbound webhook delivery. Publish a message; every enabled endpoint subscribed to its event type receives a signed POST, retried on a fixed schedule, dead-lettered when exhausted, replayable on demand."
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {}
