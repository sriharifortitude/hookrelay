    "/messages": {
      "post": {
        "summary": "Publish a message to every subscribed endpoint",
        "tags": [
          "messages"
        ],
        "description": "Send an Idempotency-Key header to make the request safe to retry: a repeat with the same key returns the original message and publishes nothing.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "eventType",
                  "payload"
                ],
                "properties": {
                  "eventType": {
                    "minLength": 1,
                    "maxLength": 200,
                    "type": "string",
                    "example": "order.created"
                  },
                  "payload": {
                    "description": "Any JSON. Delivered under \"data\" in the signed envelope."
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "minLength": 1,
              "maxLength": 255,
              "type": "string"
            },
            "in": "header",
            "name": "idempotency-key",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "eventType",
                    "createdAt",
                    "deliveries"
                  ],
                  "properties": {
                    "id": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "eventType": {
                      "type": "string"
                    },
                    "createdAt": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "deliveries": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "endpointId",
                          "status"
                        ],
                        "properties": {
                          "id": {
                            "format": "uuid",
                            "type": "string"
                          },
                          "endpointId": {
                            "format": "uuid",
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "201": {
