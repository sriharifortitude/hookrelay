// Every row below an Application carries applicationId directly, so the API
// layer scopes every query by the authenticated application without joins.
// There is no row-level security here: unlike a multi-user SaaS, this
// service has exactly one principal per application (its API key) and one
// code path that reads it, which the scoping helper in src/api/scope.ts
// enforces.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Application {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  // sha256 of the API key; the key itself is shown once at creation.
  apiKeyHash String   @unique
  createdAt  DateTime @default(now())

  endpoints Endpoint[]
  messages  Message[]

  @@map("applications")
}

model Endpoint {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @db.Uuid
  url           String
  description   String?
  // Standard Webhooks secrets, newest first. More than one during rotation.
  secrets       String[]
  // Event types this endpoint receives. Empty means all.
  eventTypes    String[]
  enabled       Boolean  @default(true)
  // Set when the circuit breaker trips; cleared when re-enabled by the API.
  disabledReason String?
  consecutiveFailures Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  deliveries  Delivery[]

  @@index([applicationId])
  @@map("endpoints")
}

// A published event. Immutable. One Message fans out to one Delivery per
// matching endpoint.
model Message {
  id             String   @id @default(uuid()) @db.Uuid
  applicationId  String   @db.Uuid
  eventType      String
  payload        Json
  // Client-supplied. A repeat with the same key returns the original
  // message rather than publishing twice.
  idempotencyKey String?
  createdAt      DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  deliveries  Delivery[]

  @@unique([applicationId, idempotencyKey])
  @@index([applicationId, createdAt])
  @@map("messages")
}

enum DeliveryStatus {
  pending
  succeeded
  // Retries exhausted, or a non-retryable response. Replayable.
  failed
}

model Delivery {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String         @db.Uuid
  messageId     String         @db.Uuid
  endpointId    String         @db.Uuid
  status        DeliveryStatus @default(pending)
  attemptCount  Int            @default(0)
  nextAttemptAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  message  Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  endpoint Endpoint  @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([applicationId, status, createdAt])
  @@index([endpointId, createdAt])
  @@map("deliveries")
}

// One HTTP attempt. The response body is truncated: it is diagnostic, and a
// receiver that returns its whole error page on every failure would fill
// the table.
model Attempt {
  id             String   @id @default(uuid()) @db.Uuid
  deliveryId     String   @db.Uuid
  number         Int
  responseStatus Int?
  responseBody   String?
  error          String?
  durationMs     Int
  at             DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, number])
  @@map("attempts")
}
